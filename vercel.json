{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/videos/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(css|js|svg|jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
